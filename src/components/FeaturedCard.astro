---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { getPath } from "@/utils/getPath";
import { getReadingTime } from "@/utils/readingTime";

type Props = CollectionEntry<"blog">;

const { id, data, filePath, body } = Astro.props;
const { title, description, pubDatetime, tags, ogImage } = data;

const readingTime = getReadingTime(body ?? "");
const href = getPath(id, filePath);

const formattedDate = pubDatetime.toLocaleDateString("pt-BR", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const displayTags = tags.slice(0, 3).map(t => t.replace(/-/g, " "));
---

<a
  href={href}
  class="featured-story group block w-full overflow-hidden rounded-2xl border transition-all"
  style="border-color: var(--border); background: var(--bg-surface);"
  onmouseover="this.style.borderColor='var(--accent)'; this.style.boxShadow='0 8px 32px rgba(179,120,0,0.10)'"
  onmouseout="this.style.borderColor='var(--border)'; this.style.boxShadow='none'"
>
  <!-- Imagem de capa -->
  {
    ogImage && (
      <div class="featured-image w-full overflow-hidden">
        {typeof ogImage === "string" ? (
          <img
            src={ogImage}
            alt={title}
            class="h-full w-full object-contain"
            loading="eager"
          />
        ) : (
          <Image
            src={ogImage}
            alt={title}
            class="h-full w-full object-contain"
            loading="eager"
            widths={[800, 1200]}
            sizes="100vw"
          />
        )}
      </div>
    )
  }

  <div class="p-7 sm:p-8">
    <!-- Tags -->
    {
      displayTags.length > 0 && (
        <div class="mb-4 flex flex-wrap gap-2">
          {displayTags.map(tag => (
            <span
              class="rounded-full px-2.5 py-1 text-xs font-semibold capitalize"
              style="background: var(--accent-light); color: var(--accent);"
            >
              {tag}
            </span>
          ))}
        </div>
      )
    }

    <!-- Title -->
    <h2
      class="mb-3 text-xl leading-snug font-bold sm:text-2xl"
      style="color: var(--foreground); letter-spacing: -0.02em;"
    >
      {title}
    </h2>

    <!-- Description -->
    <p
      class="mb-5 max-w-2xl text-base leading-relaxed"
      style="color: var(--text-secondary);"
    >
      {description}
    </p>

    <!-- Meta + CTA -->
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div
        class="flex items-center gap-2 text-sm"
        style="color: var(--text-secondary);"
      >
        <time datetime={pubDatetime.toISOString()}>{formattedDate}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime} de leitura</span>
      </div>
      <span
        class="inline-flex items-center gap-1 text-sm font-semibold transition-colors"
        style="color: var(--accent);"
      >
        Ler artigo →
      </span>
    </div>
  </div>
</a>
