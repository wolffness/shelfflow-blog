---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import FeaturedCard from "@/components/FeaturedCard.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
const featuredPost =
  sortedPosts.find(({ data }) => data.featured) ?? sortedPosts[0];
const otherPosts = sortedPosts
  .filter(p => p.id !== featuredPost?.id)
  .slice(0, SITE.postPerIndex - 1);
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    class="editorial-index app-layout"
  >
    <!-- Hero -->
    <section class="border-b border-border pt-10 pb-8">
      <p
        class="mb-3 text-xs font-semibold tracking-widest uppercase"
        style="color: var(--accent);"
      >
        Blog ShelfFlow
      </p>
      <h1
        class="mb-4 text-3xl leading-tight font-bold sm:text-4xl"
        style="color: var(--foreground); letter-spacing: -0.025em;"
      >
        Produtos bem apresentados.<br class="hidden sm:block" /> Uma operação mais
        organizada.
      </h1>
      <p
        class="max-w-xl text-base leading-relaxed"
        style="color: var(--text-secondary);"
      >
        Guias, tutoriais e comparações para organizar vitrines, looks, compre
        junto e campanhas na sua Nuvemshop.
      </p>
    </section>

    <nav class="editorial-topics" aria-label="Explore por assunto">
      <a href="/tags/compre-junto/">Compre junto</a>
      <a href="/tags/nuvemshop/">Nuvemshop</a>
      <a href="/compare/">Compare soluções</a>
      <a href="https://shelfflow.com.br/help/">Central de ajuda ↗</a>
    </nav>

    <!-- Artigo em destaque -->
    {
      featuredPost && (
        <section class="border-b border-border pt-10 pb-8">
          <h2
            class="mb-5 text-xs font-semibold tracking-widest uppercase"
            style="color: var(--text-secondary);"
          >
            Em destaque
          </h2>
          <FeaturedCard {...featuredPost} />
        </section>
      )
    }

    <!-- Últimos artigos -->
    {
      otherPosts.length > 0 && (
        <section class="border-b border-border pt-10 pb-8">
          <h2
            class="mb-5 text-xs font-semibold tracking-widest uppercase"
            style="color: var(--text-secondary);"
          >
            Últimos artigos
          </h2>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            {otherPosts.map(post => (
              <ArticleCard {...post} />
            ))}
          </div>
        </section>
      )
    }

    <!-- Pré-lançamento CTA -->
    <section class="py-12">
      <div
        class="rounded-2xl p-8 text-center"
        style="background: var(--accent-light);"
      >
        <p
          class="mb-3 text-xs font-semibold tracking-widest uppercase"
          style="color: var(--accent);"
        >
          Pré-lançamento
        </p>
        <h2
          class="mb-2 text-xl font-bold sm:text-2xl"
          style="color: var(--foreground); letter-spacing: -0.02em;"
        >
          Conheça o ShelfFlow antes do lançamento
        </h2>
        <p
          class="mx-auto mb-6 max-w-md text-sm"
          style="color: var(--text-secondary);"
        >
          Vitrines, looks, compre junto e grupos de produtos na Meta. Cadastre
          seu interesse para acompanhar a abertura para novas lojas.
        </p>
        <a
          href="https://shelfflow.com.br/use"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold text-white transition-colors"
          style="background: var(--accent); white-space: nowrap;"
          onmouseover="this.style.background='var(--accent-hover)'"
          onmouseout="this.style.background='var(--accent)'"
        >
          Entrar na lista de espera →
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
