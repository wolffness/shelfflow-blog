---
import { getCollection, render, type CollectionEntry } from "astro:content";
import RelatedReading from "@/components/RelatedReading.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import postFilter from "@/utils/postFilter";
export async function getStaticPaths() {
  return (await getCollection("comparisons"))
    .filter(postFilter)
    .map(post => ({ params: { slug: post.id }, props: { post } }));
}
type Props = { post: CollectionEntry<"comparisons"> };
const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout
  title={post.data.title}
  description={post.data.description}
  pubDatetime={post.data.pubDatetime}
  ogImage={post.data.ogImage}
>
  <Header />
  <main id="main-content" class="app-layout py-10">
    <a class="text-sm underline" href="/compare/">Todas as comparações</a>
    <article>
      <h1 class="mt-5 mb-6 text-3xl font-bold">{post.data.title}</h1>
      <p class="mb-8 text-sm">
        Publicado em {
          post.data.pubDatetime.toLocaleDateString("pt-BR", {
            timeZone: "America/Sao_Paulo",
          })
        } · Fontes revistas em {
          post.data.reviewedOn.toLocaleDateString("pt-BR", { timeZone: "UTC" })
        }
      </p>
      {
        post.data.ogImage && (
          <img
            src={post.data.ogImage}
            alt={post.data.title}
            class="comparison-cover"
            width="1024"
            height="1024"
          />
        )
      }
      <div class="app-prose w-full max-w-none"><Content /></div>
    </article>
    <RelatedReading
      currentId={post.id}
      collection="comparisons"
      tags={post.data.tags}
    />
  </main>
  <Footer />
</Layout>
